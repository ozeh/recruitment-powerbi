table measure_table
	lineageTag: 45d75489-6039-47b0-ae49-8b734c41afde

	measure Revenue = sum(fact_sales[Sales])
		lineageTag: 1ea32689-5603-4c20-9a6f-2dd2ef894629

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cost' = sum(fact_sales[Cost])
		lineageTag: a7adba48-fe49-4513-9589-dbfa28da424c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Volume' = sum(fact_sales[Quantity])
		formatString: 0
		lineageTag: a7eeadd9-7c67-413c-b022-cbf76a219ea2

	measure 'Revenue PY' =
			
			VAR PreviousYearRevenue =
			    CALCULATE(
			        [Revenue],
			        SAMEPERIODLASTYEAR('calendar'[Date])
			    )
			RETURN
			    PreviousYearRevenue
		lineageTag: f5ca76b2-538e-481a-a93c-e3bcbd09c216

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Profit = sum(fact_sales[Profit])
		lineageTag: 9cd4ba13-7ac2-4b23-9f05-6ccd22cbdd1a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Margin = divide([Profit], [Revenue], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 00fd8b4f-6696-40f1-a8a8-a979ceb21b45

	measure 'Revenue PLN' = sum(fact_sales[Sales PLN])
		lineageTag: cb1934dc-6001-482f-96ba-07d056d86f40

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Sales for Pie' =
			
			VAR TopCustomers =
			    TOPN(
			        5,
			        ALLSELECTED(dim_product[Category]),
			        [Revenue],
			        DESC
			    )
			
			VAR CurrentCustomer =
			    SELECTEDVALUE('Customer Group'[Product Category])
			
			VAR TopCustomerSales =
			    CALCULATE(
			        [Revenue],
			        TREATAS(
			            { CurrentCustomer },
			            dim_product[Category]
			        )
			    )
			
			VAR OtherSales =
			    CALCULATE(
			        [Revenue],
			        EXCEPT(
			            ALLSELECTED(dim_product[Category]),
			            SELECTCOLUMNS(
			                TopCustomers,
			                "Customer Name", dim_product[Category]
			            )
			        )
			    )
			
			RETURN
			    IF(
			        CurrentCustomer = "Others",
			        OtherSales,
			        IF(
			            CONTAINS(
			                TopCustomers,
			                dim_product[Category],
			                CurrentCustomer
			            ),
			            TopCustomerSales,
			            BLANK()
			        )
			    )
		lineageTag: b0a42592-488f-4013-b9aa-bdac6460d2c8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YOY%' = ([Revenue] - [Revenue PY]) / [Revenue]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7ecb181f-82ad-4baf-a5bf-4d9fe90a9ac2

	measure 'Min Revenue' =
			
			VAR CurrentValue = [Revenue]
			VAR MinValue =
			    MINX(
			        ALLSELECTED('calendar'[Year Month]),
			        [Revenue]
			    )
			RETURN
			    IF(CurrentValue = MinValue, 1)
		lineageTag: d998763b-a640-4e41-a19b-3304ece76151

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Revenue' =
			
			VAR CurrentValue = [Revenue]
			VAR MinValue =
			    MINX(
			        ALLSELECTED('calendar'[Year Month]),
			        [Revenue]
			    )
			VAR MaxValue =
			    MAXX(
			        ALLSELECTED('calendar'[Year Month]),
			        [Revenue]
			    )
			RETURN
			    switch(CurrentValue,
			    MinValue, 1,
			    MaxValue, 2,
			    0)
		lineageTag: df3a8615-166f-44ac-aba1-e865c493500d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition measure_table = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

